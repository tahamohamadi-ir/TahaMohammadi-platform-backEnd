# Local examples only. Copy to `.env` (never commit `.env`).
# Replace production values through the deployment secret store.

# -----------------------------------------------------------------------------
# Database profiles (pick ONE)
# -----------------------------------------------------------------------------

# RECOMMENDED — new platform disposable PostgreSQL (Back-End/docker-compose.dev.yml)
# Host port 5433, database taha_platform_dev. See docs/operations/LOCAL-DATABASE.md.
DATABASE_URL=postgres://taha_dev:taha_dev_local_only@127.0.0.1:5433/taha_platform_dev

# LEGACY — monorepo taha-local Docker profile (Infra/legacy-monorepo/cms/docker-compose.local.yml)
# Uses config.settings.local, NOT config.settings.development. Port 15432.
# DATABASE_URL=postgres://taha:taha_local_only@127.0.0.1:15432/taha

# STANDALONE — local PostgreSQL install (non-Docker); set your own throwaway credentials.
# DATABASE_URL=postgresql://local_user:local_password@127.0.0.1:5432/taha_local

# NO DATABASE_URL — config.settings.development uses SQLite (dev.sqlite3) for bare CLI only.

# -----------------------------------------------------------------------------
# Do NOT use the legacy tahamohamadi-website stack Postgres (ports 80/443).
# That stack is unrelated to new-platform development.
# -----------------------------------------------------------------------------

ADMIN_SPA_ROOT=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@tahamohamadi.ir
CONTACT_FORM_TO=

# Production-required or sensitive values; never commit real values.
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
POSTGRES_DB=taha_cms
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REBUILD_TRIGGER_ENABLED=false
REBUILD_TRIGGER_SECRET=
REBUILD_SCRIPT_PATH=
PREVIEW_SHARE_SECRET=
FEATURE_ADMIN_BULK_ARCHIVE=false

# Local examples only. Replace production values through the deployment secret store.
# Docker-local profile used by config.settings.local and infra/cms/docker-compose.local.yml.
DATABASE_URL=postgres://taha:taha_local_only@127.0.0.1:15432/taha
# Standalone PostgreSQL alternative: replace the DATABASE_URL above explicitly
# with your own non-production database URL, for example:
# DATABASE_URL=postgresql://local_user:local_password@127.0.0.1:5432/taha_local
ADMIN_SPA_ROOT=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@tahamohamadi.ir
CONTACT_FORM_TO=

# Production-required or sensitive values; never commit real values.
DJANGO_SECRET_KEY=
ALLOWED_HOSTS=
POSTGRES_DB=taha_cms
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REBUILD_TRIGGER_ENABLED=false
REBUILD_TRIGGER_SECRET=
REBUILD_SCRIPT_PATH=
PREVIEW_SHARE_SECRET=
FEATURE_ADMIN_BULK_ARCHIVE=false

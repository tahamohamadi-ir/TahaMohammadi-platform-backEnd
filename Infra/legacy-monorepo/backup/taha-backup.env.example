# This file contains locations and a repository URI only. Do not put passwords,
# OAuth tokens, or rclone token values in it.
RCLONE_CONFIG=/root/.config/rclone/rclone.conf
RESTIC_PASSWORD_FILE=/root/.config/taha-backup/restic-password
RESTIC_REPOSITORY=rclone:gdrive_taha_backup:taha-personal-platform-backups/restic-repository

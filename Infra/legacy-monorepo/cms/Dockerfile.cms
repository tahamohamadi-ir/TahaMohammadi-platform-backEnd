# syntax=docker/dockerfile:1
#
# Multi-stage image for the CMS runtime (Django 5.2.9 / Ninja 1.6.2).
# Build context is the repository root (needed for apps/cms/ + uv.lock).
# Runtime env vars (DJANGO_SECRET_KEY, POSTGRES_*, etc.) come from the compose
# .env at runtime — never baked into the image.
#
# Versioning: CI tags and pushes
#   ghcr.io/<owner>/taha-cms:<git-sha>
#   ghcr.io/<owner>/taha-cms:main
# Production pulls a specific sha tag (immutable); :main is a convenience pointer.

FROM python:3.12-slim AS builder
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:0.8.5 /uv /uvx /bin/
WORKDIR /build
COPY apps/cms/pyproject.toml apps/cms/uv.lock ./
RUN uv sync --frozen --no-dev \
    && .venv/bin/python -c "import argon2, whitenoise, gunicorn, django, qrcode"

# ADR-0032 S4: the admin SPA moved to apps/admin with its own image/pipeline
# (Dockerfile.admin + ci-admin.yml + cd). This image no longer builds or bakes
# it; Django's admin_spa.py serves ADMIN_SPA_ROOT if set (transition fallback).

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    DJANGO_SETTINGS_MODULE=config.settings.production \
    VIRTUAL_ENV=/app/.venv
WORKDIR /app
COPY --from=builder /build/.venv ./.venv
COPY apps/cms ./
RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin app \
    && mkdir -p staticfiles media \
    && chown -R app:app /app
# Build-time-only dummy values for collectstatic; not secrets and never used at runtime.
RUN USER=app GROUP=app HOME=/home/app \
    DJANGO_SETTINGS_MODULE=config.settings.test \
    DJANGO_SECRET_KEY=build-time-only-no-secret \
    ALLOWED_HOSTS=localhost \
    python manage.py collectstatic --noinput

USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=5 \
    CMD ["python", "-c", "import json,urllib.request; d=json.load(urllib.request.urlopen('http://127.0.0.1:8000/health/', timeout=3)); raise SystemExit(0 if d.get('db')=='ok' else 1)"]
CMD ["python", "-m", "gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "config.wsgi:application"]

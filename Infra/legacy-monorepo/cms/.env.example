# CMS runtime environment template — copy to infra/cms/.env on the VPS (chmod 600).
# Never commit a real .env. Generate secrets on the server (openssl / password manager).

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-50-plus-char-random-secret
ALLOWED_HOSTS=tahamohamadi.ir,www.tahamohamadi.ir

# --- PostgreSQL (compose service name is `db`) ---
POSTGRES_DB=taha_cms
POSTGRES_USER=taha_cms
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Outbound email (contact form, board A10) ---
# Without EMAIL_HOST the public contact form answers 503 honestly.
# Use a real mailbox/SMTP account; keep the password ONLY in this .env (chmod 600).
# Boot/health validation: /health/ reports degraded when SiteSettings.contact_form_enabled
# is true but EMAIL_HOST is empty or no recipient (CONTACT_FORM_TO / SiteSettings.contact_email)
# is configured — so operator does not see green health while contact 503s. See apps/health/views.py.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@tahamohamadi.ir
# Optional recipient override; defaults to SiteSettings.contact_email from the admin.
CONTACT_FORM_TO=

# --- Rebuild trigger (keep disabled until owner smoke of rebuild-web.sh) ---
REBUILD_TRIGGER_ENABLED=false
REBUILD_TRIGGER_SECRET=
# Optional path to rebuild-web.sh if this process can execute it (DEFER-0027).
# REBUILD_SCRIPT_PATH=/home/deploy/cms-repo/infra/deploy/rebuild-web.sh

# --- Admin feature flags (S4; default off) ---
# FEATURE_ADMIN_BULK_ARCHIVE=false

# --- Public preview share tokens (DEFER-0016) ---
# Generate on server: openssl rand -hex 32
PREVIEW_SHARE_SECRET=

# --- Image selection (optional; usually exported in the shell, not in .env) ---
# CMS_IMAGE=ghcr.io/tahamohamadi-ir/taha-cms:<git-sha>
# CMS_PULL_POLICY=always

# OPTIONAL — public read-only CMS API + published media (DEFER-0017)
#
# Apply ONLY after owner approval per docs/plan/P3-public-api-caddy-task-spec.md.
# Insert INSIDE the tahamohamadi.ir site block BEFORE import taha_application_routes.
#
# Prerequisites:
#   - CMS running on 127.0.0.1:18000 with Ninja read-only public projection
#   - Migrations 0002+ applied; content published via the admin (SPA /admin/
#     or staff HTML /staff/)
#   - RISK-0003 backup evidence recommended before first prod migrate
#
# After edit:
#   sudo cp -a /etc/caddy/Caddyfile /etc/caddy/Caddyfile.pre-api.<timestamp>
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy

# Admin APIs must NEVER be cached at the edge (session + CSRF + TOTP). Match
# both the new /api/v1/admin/* namespace (ADR-0026) and the existing
# /api/admin/* profile admin before the generic /api/* handle.
handle /api/v1/admin/* {
	reverse_proxy 127.0.0.1:18000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_down Cache-Control "no-store, no-cache, must-revalidate"
		header_down X-Robots-Tag "noindex, nofollow"
	}
}

handle /api/admin/* {
	reverse_proxy 127.0.0.1:18000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_down Cache-Control "no-store, no-cache, must-revalidate"
		header_down X-Robots-Tag "noindex, nofollow"
	}
}

handle /api/* {
	reverse_proxy 127.0.0.1:18000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_down Cache-Control "public, max-age=60"
	}
}

handle /media/* {
	reverse_proxy 127.0.0.1:18000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_down Cache-Control "public, max-age=86400"
	}
}
